# 统一用 LF 存，避免 Windows 上 CRLF 把 diff 撑爆
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# 二进制，别当文本处理
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
